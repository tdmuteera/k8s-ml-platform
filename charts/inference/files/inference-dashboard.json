{
  "uid": "ml-inference",
  "title": "ML inference",
  "tags": ["inference"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Prediction rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inference_requests_total{status=\"ok\"}[2m]))",
          "legendFormat": "ok"
        },
        {
          "refId": "B",
          "expr": "sum(rate(inference_requests_total{status!=\"ok\"}[2m]))",
          "legendFormat": "not ok"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Prediction latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inference_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(inference_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ready replicas",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"ml-inference\", deployment=\"inference\"}"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Container CPU",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 10, "x": 6, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"ml-inference\", container=\"inference\"}[2m]))",
          "legendFormat": "cores"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      }
    },
    {
      "id": 5,
      "type": "text",
      "title": "How to read this",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8},
      "options": {
        "mode": "markdown",
        "content": "This dashboard shows the inference service. Run `make load` from the repository root to create traffic and to give the autoscaler a reason to add pods. Request rate and latency come from the service. Replica count comes from kube-state-metrics. CPU comes from the kubelet."
      }
    }
  ]
}
